# Project One Move-Between-Rooms Pseudocode
#
# Graded checkpoint: Module Five Project One
# Later use: conceptual support for M6; movement design for M7
#
# Review the course-provided movement flowchart before completing this file.
# Write pseudocode, not Python code. Use clear indentation and course-appropriate
# keywords such as INPUT, OUTPUT, IF, ELSE, WHILE, SET, or similar terms.

START move

SET current_room = "Food Court"

WHILE game is running
    DISPLAY current_room
    PROMPT player to enter a direction: North, South, East, or West
    GET player_direction

    IF player_direction is North, South, East, or West
        IF player_direction is a valid direction from current_room
            MOVE player in player_direction
            SET current_room = new room
            DISPLAY "You moved to " + current_room
        ELSE
            DISPLAY "You cannot go that way."
        END IF
    ELSE
        DISPLAY "Invalid direction. Enter North, South, East, or West."
    END IF
END WHILE

END move