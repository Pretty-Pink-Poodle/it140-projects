# Project One Get-Item Pseudocode
#
# Graded checkpoint: Module Five Project One
# Later use: get-item and inventory design for M7 Project Two
#
# Review the course-provided get-item flowchart before completing this file.
# Write pseudocode, not Python code. Use clear indentation and course-appropriate
# keywords such as INPUT, OUTPUT, IF, ELSE, SET, ADD, or similar terms.

START get_item

SET inventory = empty list

WHILE game is running
    DISPLAY current_room
    DISPLAY inventory

    IF current_room contains an item
        DISPLAY item in current_room
    END IF

    PROMPT player to enter the item they want to get
    GET player_item

    IF current_room contains an item
        IF player_item is the item in current_room
            ADD player_item to inventory
            REMOVE player_item from current_room
            DISPLAY player_item + " added to inventory."
        ELSE
            DISPLAY "That item is not in this room."
        END IF
    ELSE
        DISPLAY "There is no item to collect in this room."
    END IF
END WHILE

END get_item


